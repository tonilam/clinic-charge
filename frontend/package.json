{
  "name": "clinic-charges",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 3000",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:run": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "e2e": "npx playwright test --config=e2e/playwright.config.ts",
    "e2e:headed": "npx playwright test --config=e2e/playwright.config.ts --headed",
    "e2e:ui": "npx playwright test --config=e2e/playwright.config.ts --ui",
    "e2e:report": "npx playwright show-report e2e/test-results/html"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "ag-grid-angular": "^33.2.5",
    "ag-grid-community": "^33.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.49.1",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.21",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.5",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
